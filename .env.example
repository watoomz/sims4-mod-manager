# Optional CurseForge API key; get one from https://console.curseforge.com/ for CurseForge catalog features.
CURSEFORGE_API_KEY=
# Version label for the published Windows client; defaults to "dev" when unset.
CLIENT_VERSION=
# Host port exposed for the backend (container listens on 8080).
HOST_PORT=8080
# The database and archive directories are Docker named volumes (db_data,
# archive_data) managed by Compose, not host paths -- this avoids file
# permission mismatches between your host user and the container's
# non-root user. See README.md for how to back them up or use a host path
# instead if you prefer.
